<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_normal"
    android:fitsSystemWindows="true"
    android:padding="16dp">

    <!-- Panel Pomodoro Superior -->
    <LinearLayout
        android:id="@+id/layoutPomodoro"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="8dp"
        android:background="#1A000000"
        android:layout_alignParentTop="true"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/tvPomodoroTimer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/timer_default"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/text_title_normal"
            android:layout_marginEnd="16dp"/>

        <Button
            android:id="@+id/btnStartPomodoro"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/btn_start_pomodoro"
            android:layout_marginEnd="8dp"/>

        <Button
            android:id="@+id/btnResetPomodoro"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/btn_reset_pomodoro"/>
    </LinearLayout>

    <!-- Botón para abrir PDF -->
    <Button
        android:id="@+id/btnOpenPdf"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_below="@id/layoutPomodoro"
        android:layout_marginTop="8dp"
        android:text="@string/btn_open_pdf" />

    <!-- Información de Estado y Sensor -->
    <TextView
        android:id="@+id/tvStatusTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_toStartOf="@id/btnOpenPdf"
        android:layout_alignParentStart="true"
        android:layout_below="@id/layoutPomodoro"
        android:layout_marginTop="8dp"
        android:text="@string/status_title_normal"
        android:textColor="@color/text_title_normal"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvStatusDesc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/tvStatusTitle"
        android:text="@string/status_desc_normal"
        android:textColor="@color/text_desc_normal"
        android:textSize="14sp"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/tvSensorInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/tvStatusDesc"
        android:text="@string/sensor_info_default"
        android:textColor="@color/sensor_text_normal"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp"/>

    <!-- Banner de Alertas de Salud (No bloqueante) -->
    <TextView
        android:id="@+id/tvHealthAlert"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/tvSensorInfo"
        android:background="#FFFF0000"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:padding="8dp"
        android:gravity="center"
        android:visibility="gone"
        android:layout_marginBottom="4dp"/>

    <!-- Contenedor Scrollable estable para el PDF -->
    <HorizontalScrollView
        android:id="@+id/horizontalScrollPdf"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_above="@id/layoutPagination"
        android:layout_below="@id/tvHealthAlert"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:fillViewport="true">

        <ScrollView
            android:id="@+id/verticalScrollPdf"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <RelativeLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <!-- Imagen del PDF -->
                <ImageView
                    android:id="@+id/pdfImageView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:adjustViewBounds="true"
                    android:scaleType="fitCenter"
                    android:contentDescription="@string/pdf_image_desc" />

                <!-- Filtro Nocturno / Cálido superpuesto -->
                <View
                    android:id="@+id/warmFilterOverlay"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#33FF9100"
                    android:visibility="gone" />

            </RelativeLayout>
        </ScrollView>
    </HorizontalScrollView>

    <!-- Barra de navegación de páginas con texto de alto contraste -->
    <LinearLayout
        android:id="@+id/layoutPagination"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal"
        android:gravity="center"
        style="?android:attr/buttonBarStyle">

        <Button
            android:id="@+id/btnPrevPage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="@string/btn_prev_page"
            android:textColor="@color/text_title_normal"
            style="?android:attr/buttonBarButtonStyle" />

        <Button
            android:id="@+id/btnNextPage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/btn_next_page"
            android:textColor="@color/text_title_normal"
            style="?android:attr/buttonBarButtonStyle" />

    </LinearLayout>

    <!-- Overlay de Bloqueo Anti-procrastinación -->
    <RelativeLayout
        android:id="@+id/layoutLockOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#E6000000"
        android:elevation="10dp"
        android:visibility="gone"
        android:gravity="center"
        android:padding="32dp">

        <TextView
            android:id="@+id/tvLockMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/lock_message"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="24dp"/>

        <Button
            android:id="@+id/btnUnlock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/tvLockMessage"
            android:layout_centerHorizontal="true"
            android:text="@string/btn_unlock"/>
    </RelativeLayout>

</RelativeLayout>